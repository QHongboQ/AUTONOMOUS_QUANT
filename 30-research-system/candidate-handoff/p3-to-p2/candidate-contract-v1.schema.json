{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AUTONOMOUS_QUANT P3 Candidate-to-P2 Contract V1",
  "description": "Static fail-closed identity contract for handing one completed P3 research candidate to P2 certification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_contract_version",
    "candidate_id",
    "rdagent_research_identity",
    "qlib_recorder_identity",
    "artifact_identity_bundle",
    "dataset_identity_bundle",
    "runtime_identity_bundle",
    "p2_target_and_eligibility_boundary"
  ],
  "properties": {
    "candidate_contract_version": {
      "const": "P3_CANDIDATE_TO_P2_CONTRACT_V1"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rdagent_research_identity": {
      "$ref": "#/$defs/rdagentResearchIdentity"
    },
    "qlib_recorder_identity": {
      "$ref": "#/$defs/qlibRecorderIdentity"
    },
    "artifact_identity_bundle": {
      "$ref": "#/$defs/artifactIdentityBundle"
    },
    "dataset_identity_bundle": {
      "$ref": "#/$defs/datasetIdentityBundle"
    },
    "runtime_identity_bundle": {
      "$ref": "#/$defs/runtimeIdentityBundle"
    },
    "p2_target_and_eligibility_boundary": {
      "$ref": "#/$defs/p2TargetAndEligibilityBoundary"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_role",
        "sha256"
      ],
      "properties": {
        "logical_role": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "lineageIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation",
        "parent_research_sha256"
      ],
      "properties": {
        "relation": {
          "enum": [
            "based_experiment",
            "dag_parent"
          ]
        },
        "parent_research_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "dvcIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "md5",
            "sha256",
            "etag"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      }
    },
    "dvcDependencyIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_role",
        "dvc_identity"
      ],
      "properties": {
        "logical_role": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "dvc_identity": {
          "$ref": "#/$defs/dvcIdentity"
        }
      }
    },
    "artifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_role",
        "sha256",
        "dvc_output_identity"
      ],
      "properties": {
        "logical_role": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "dvc_output_identity": {
          "$ref": "#/$defs/dvcIdentity"
        }
      }
    },
    "staticTemplateIdentity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relative_name",
            "sha256"
          ],
          "properties": {
            "relative_name": {
              "const": "factor_template/conf_baseline.yaml"
            },
            "sha256": {
              "const": "ddfb7dd65875636db4cc0acb2471ae1c48d07a30b88b60380ef2a355fdf3d73c"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relative_name",
            "sha256"
          ],
          "properties": {
            "relative_name": {
              "const": "factor_template/conf_combined_factors.yaml"
            },
            "sha256": {
              "const": "2758f1f764bc38a1193f3e78320a65eaecdf3360aada2c300881dee5c54f2426"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relative_name",
            "sha256"
          ],
          "properties": {
            "relative_name": {
              "const": "factor_template/conf_combined_factors_sota_model.yaml"
            },
            "sha256": {
              "const": "8f5fac7c7f6592f282556c51f5b34c078460db46f9ee3a54c3bcc31385e6d119"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relative_name",
            "sha256"
          ],
          "properties": {
            "relative_name": {
              "const": "model_template/conf_baseline_factors_model.yaml"
            },
            "sha256": {
              "const": "6f4aeab4e422e0e4b266c42f132ffd8a8a1b27cfbec74513a92745e60d7cb260"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relative_name",
            "sha256"
          ],
          "properties": {
            "relative_name": {
              "const": "model_template/conf_sota_factors_model.yaml"
            },
            "sha256": {
              "const": "4a08250b0e0906f10a4856992aec1bb85f144076d1d4cf1ba34c90fa544b5d69"
            }
          }
        }
      ]
    },
    "rdagentResearchIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_mode",
        "scenario_family",
        "hypothesis_content_sha256",
        "task_content_identities",
        "experiment_structure_sha256",
        "generated_research_code_identities",
        "parent_lineage_content_identities"
      ],
      "properties": {
        "research_mode": {
          "enum": [
            "fin_factor",
            "fin_model",
            "fin_quant"
          ]
        },
        "scenario_family": {
          "const": "P3_US_RAGGED_QLIB"
        },
        "hypothesis_content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "task_content_identities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contentIdentity"
          }
        },
        "experiment_structure_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "generated_research_code_identities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contentIdentity"
          }
        },
        "parent_lineage_content_identities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/lineageIdentity"
          }
        }
      }
    },
    "qlibRecorderIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_id",
        "run_id",
        "status"
      ],
      "properties": {
        "experiment_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "FINISHED"
        }
      }
    },
    "artifactIdentityBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dvc_stage_name",
        "dvc_lock_file_sha256",
        "dvc_stage_lock_entry_sha256",
        "dvc_run_root_output_identity",
        "selected_static_templates",
        "rendered_qlib_execution_config_sha256",
        "generated_research_code_artifacts",
        "serialized_model_artifact",
        "prediction_artifact"
      ],
      "properties": {
        "dvc_stage_name": {
          "const": "p3_rdagent_us_quant_research"
        },
        "dvc_lock_file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "dvc_stage_lock_entry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "dvc_run_root_output_identity": {
          "$ref": "#/$defs/dvcIdentity"
        },
        "selected_static_templates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/staticTemplateIdentity"
          }
        },
        "rendered_qlib_execution_config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "generated_research_code_artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifactIdentity"
          }
        },
        "serialized_model_artifact": {
          "$ref": "#/$defs/artifactIdentity"
        },
        "prediction_artifact": {
          "$ref": "#/$defs/artifactIdentity"
        }
      }
    },
    "datasetIdentityBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_build_report_sha256",
        "calendar_sha256",
        "all_instruments_sha256",
        "p2_pit_instruments_sha256",
        "date_bounds",
        "security_identity_count",
        "membership_range_count",
        "member_session_row_count",
        "p3_dvc_dependency_identities"
      ],
      "properties": {
        "provider_build_report_sha256": {
          "const": "eda5e8bb8e3f274d2893ea6a09f5764111f59c9cadf40eb32e3fbce199a68142"
        },
        "calendar_sha256": {
          "const": "d4c0c100af851245f6f894e275e5d494d7e1cbd07f82d342c034cbdf7b7bfa4d"
        },
        "all_instruments_sha256": {
          "const": "24d3a9010b725f8121ae1a999916bd0b6e76923eb9fad85be7e57d8653cc2cbc"
        },
        "p2_pit_instruments_sha256": {
          "const": "e771f73b91664b26584e66c42eb007c4276c492071172e7d6594bc900f01f875"
        },
        "date_bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "const": "2015-01-02"
            },
            "end": {
              "const": "2024-12-31"
            }
          }
        },
        "security_identity_count": {
          "const": 730
        },
        "membership_range_count": {
          "const": 745
        },
        "member_session_row_count": {
          "const": 1267963
        },
        "p3_dvc_dependency_identities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dvcDependencyIdentity"
          }
        }
      }
    },
    "runtimeIdentityBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rdagent_source_git_sha",
        "rdagent_installed_wheel_sha256",
        "rdagent_environment_freeze_sha256",
        "qlib_source_git_sha"
      ],
      "properties": {
        "rdagent_source_git_sha": {
          "const": "32b3d395e73d9db5eee3fe9063d69aec0fdc83bd"
        },
        "rdagent_installed_wheel_sha256": {
          "const": "6d4b78037016951d21879249152fee21df90e5dca0a752e233026a41afe64395"
        },
        "rdagent_environment_freeze_sha256": {
          "const": "1d60835745fad44b917eff46918719f8c1c392fb05747f06fb4dde8cb8c1f67e"
        },
        "qlib_source_git_sha": {
          "const": "2fb9380b342556ddb50a4b24e4fe8655d548b2b8"
        }
      }
    },
    "p2TargetAndEligibilityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_protocol_version",
        "protocol_sha256",
        "protocol_activation_sha256",
        "protocol_freeze_merge_sha",
        "protocol_freeze_authority",
        "candidate_eligibility_status",
        "eligibility_authority",
        "sealed_oos_start",
        "sealed_oos_accessed_by_p3",
        "p3_can_issue_certified",
        "p3_can_edit_protocol",
        "p3_can_promote_to_production"
      ],
      "properties": {
        "target_protocol_version": {
          "const": "P2_CERTIFICATION_PROTOCOL_V1"
        },
        "protocol_sha256": {
          "const": "a9aed881c229f9eb7f85fa23b866168a55dc9c00be3c3b178d91a4af20451dfb"
        },
        "protocol_activation_sha256": {
          "const": "d1ac67558f59d917eb71d666e48967f8f20bafc48bfc1ff616b7c85e262eef54"
        },
        "protocol_freeze_merge_sha": {
          "const": "8cd703b4108d2e377d146de8384b63c0355e93a6"
        },
        "protocol_freeze_authority": {
          "const": "P2_CERTIFICATION"
        },
        "candidate_eligibility_status": {
          "enum": [
            "ELIGIBLE_UNDER_TARGET_PROTOCOL",
            "INELIGIBLE_REQUIRES_PROTOCOL_EXPANSION"
          ]
        },
        "eligibility_authority": {
          "const": "P2_CERTIFICATION"
        },
        "sealed_oos_start": {
          "const": "2026-09-14"
        },
        "sealed_oos_accessed_by_p3": {
          "const": false
        },
        "p3_can_issue_certified": {
          "const": false
        },
        "p3_can_edit_protocol": {
          "const": false
        },
        "p3_can_promote_to_production": {
          "const": false
        }
      }
    }
  }
}
