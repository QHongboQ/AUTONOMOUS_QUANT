FROM python:3.10-slim@sha256:6ff506466f8b1e981719b468cc0023b8ef000b983cdec0eafe119d01f379e31d
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
RUN python -m pip install --no-cache-dir rdagent==1.0.0 && useradd --uid 10001 --create-home --shell /usr/sbin/nologin rdagent-worker
WORKDIR /app
COPY --chown=10001:10001 native_smoke.py /app/native_smoke.py
USER 10001:10001
