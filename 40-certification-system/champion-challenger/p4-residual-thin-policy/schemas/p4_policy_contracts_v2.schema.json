      },
      "required": [
        "contract_version",
        "status",
        "metric_kind",
        "corroboration_required"
      ],
      "title": "FinancialDecayPolicyConfigV1",
      "type": "object"
    },
    "FinancialDecayPolicyConfigV2": {
      "additionalProperties": false,
      "description": "First preregistered production RankIC decay policy.",
      "properties": {
        "contract_version": {
          "const": "FinancialDecayPolicyConfigV2",
          "title": "Contract Version",
          "type": "string"
        },
        "corroboration_required": {
          "const": true,
          "title": "Corroboration Required",
          "type": "boolean"
        },
        "current_sample_sessions": {
          "minimum": 1,
          "title": "Current Sample Sessions",
          "type": "integer"
        },
        "current_window_must_start_on_or_after_effective_epoch": {
          "const": true,
          "title": "Current Window Must Start On Or After Effective Epoch",
          "type": "boolean"
        },
        "effective_epoch": {
          "format": "date",
          "title": "Effective Epoch",
          "type": "string"
        },
        "metric_kind": {
          "const": "RANK_IC",
          "title": "Metric Kind",
          "type": "string"
        },
        "minimum_current_sample_count": {
          "minimum": 1,
          "title": "Minimum Current Sample Count",
          "type": "integer"
        },
        "minimum_deterioration": {
          "exclusiveMinimum": 0.0,
          "maximum": 2.0,
          "title": "Minimum Deterioration",
          "type": "number"
        },
        "minimum_reference_sample_count": {
          "minimum": 1,
          "title": "Minimum Reference Sample Count",
          "type": "integer"
        },
        "persistence_confirmation": {
          "const": "CONSECUTIVE_ELIGIBLE_EVALUATIONS",
          "title": "Persistence Confirmation",
          "type": "string"
        },
        "policy_evaluation_cadence_sessions": {
          "minimum": 1,
          "title": "Policy Evaluation Cadence Sessions",
          "type": "integer"
        },
        "policy_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Id",
          "type": "string"
        },
        "reference_sample_sessions": {
          "minimum": 1,
          "title": "Reference Sample Sessions",
          "type": "integer"
        },
        "required_change_events": {
          "minimum": 1,
          "title": "Required Change Events",
          "type": "integer"
        },
        "required_persistence_evidence_count": {
          "minimum": 1,
          "title": "Required Persistence Evidence Count",
          "type": "integer"
        },
        "retroactive_threshold_rewrite": {
          "const": "PROHIBITED",
          "title": "Retroactive Threshold Rewrite",
          "type": "string"
        },
        "session_calendar": {
          "const": "XNYS",
          "title": "Session Calendar",
          "type": "string"
        },
        "status": {
          "const": "PREREGISTERED_PRODUCTION_POLICY",
          "title": "Status",
          "type": "string"
        },
        "window_semantics": {
          "const": "FROZEN_REFERENCE_AND_TRAILING_CURRENT",
          "title": "Window Semantics",
          "type": "string"
