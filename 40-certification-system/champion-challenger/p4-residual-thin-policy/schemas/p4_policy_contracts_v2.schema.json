          "title": "Change Detected",
          "type": "boolean"
        },
        "change_event_count": {
          "minimum": 0,
          "title": "Change Event Count",
          "type": "integer"
        },
        "contract_version": {
          "const": "DetectorEvidenceReferenceV1",
          "title": "Contract Version",
          "type": "string"
        },
        "detector_evidence_identity": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Detector Evidence Identity",
          "type": "string"
        },
        "metric_kind": {
          "const": "RANK_IC",
          "title": "Metric Kind",
          "type": "string"
        },
        "metric_observation_stream_identity": {
          "pattern": "^sha256:[0-9a-f]{64}$",
