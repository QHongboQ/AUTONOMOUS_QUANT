    "LifecycleDecisionEvidenceV1": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "capital_authorized": {
          "const": false,
          "title": "Capital Authorized",
          "type": "boolean"
        },
        "contract_version": {
          "const": "LifecycleDecisionEvidenceV1",
          "title": "Contract Version",
          "type": "string"
        },
        "current_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/LifecycleState"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision_kind": {
          "$ref": "#/$defs/DecisionKind"
        },
        "evidence_classification": {
          "enum": [
            "REAL_EXTERNAL_EVIDENCE",
            "TEST_FIXTURE_NOT_REAL_EVIDENCE"
