        },
        "live_trading_authorized": {
          "const": false,
          "title": "Live Trading Authorized",
          "type": "boolean"
        },
        "p4_champion_role_is_not_production_authorization": {
          "const": true,
          "title": "P4 Champion Role Is Not Production Authorization",
          "type": "boolean"
        },
        "production_activation_authorized": {
          "const": false,
          "title": "Production Activation Authorized",
          "type": "boolean"
        },
        "reason": {
          "$ref": "#/$defs/DecisionReason"
        },
        "source_evidence_identities": {
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Source Evidence Identities",
          "type": "array"
        },
        "target_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/LifecycleState"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "contract_version",
        "candidate_id",
        "current_state",
        "target_state",
        "decision_kind",
        "reason",
        "source_evidence_identities",
        "evidence_classification",
        "live_trading_authorized",
        "capital_authorized",
        "production_activation_authorized",
        "p4_champion_role_is_not_production_authorization"
      ],
      "title": "LifecycleDecisionEvidenceV1",
      "type": "object"
    },
