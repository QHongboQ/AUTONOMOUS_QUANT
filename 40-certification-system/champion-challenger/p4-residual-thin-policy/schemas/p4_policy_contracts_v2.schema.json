    "ChallengerReason": {
      "enum": [
        "NO_CHAMPION",
        "CHAMPION_DEGRADED"
      ],
      "title": "ChallengerReason",
      "type": "string"
    },
    "DecisionKind": {
      "enum": [
        "NO_CHANGE",
        "ADMIT_SHADOW",
        "PROMOTE_CHAMPION",
        "MARK_DEGRADED",
        "RETIRE",
        "CHALLENGER_NEEDED",
        "RESEARCH_REQUESTED",
        "REJECT_TRANSITION"
      ],
      "title": "DecisionKind",
      "type": "string"
    },
    "DecisionReason": {
      "enum": [
        "STRUCTURALLY_UNAUTHORIZED",
        "VALID_P2_CERTIFICATION_REQUIRED",
        "SHADOW_EVIDENCE_INVALID",
        "SHADOW_ADMISSION_ELIGIBLE",
        "SHADOW_EVIDENCE_NOT_COMPLETE_PASS",
        "CHAMPION_PROMOTION_ELIGIBLE",
        "DECAY_POLICY_NOT_PREREGISTERED",
        "STATISTICAL_CHANGE_NOT_DETECTED",
        "FINANCIAL_CORROBORATION_NOT_ADVERSE",
        "FINANCIAL_DECAY_CORROBORATED",
        "RETIREMENT_AUTHORIZATION_REQUIRED",
        "RETIREMENT_AUTHORIZED",
        "NO_CHAMPION",
        "CHAMPION_DEGRADED"
      ],
      "title": "DecisionReason",
      "type": "string"
