    "FinancialDecayPolicyConfigV1": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "FinancialDecayPolicyConfigV1",
          "title": "Contract Version",
          "type": "string"
        },
        "corroboration_required": {
          "const": true,
          "title": "Corroboration Required",
          "type": "boolean"
        },
        "metric_kind": {
          "const": "RANK_IC",
          "title": "Metric Kind",
          "type": "string"
        },
        "minimum_current_sample_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Current Sample Count"
        },
        "minimum_deterioration": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 2.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Deterioration"
        },
        "minimum_reference_sample_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Reference Sample Count"
        },
        "required_change_events": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Change Events"
        },
        "required_persistence_evidence_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Persistence Evidence Count"
        },
        "status": {
          "enum": [
            "UNSET_REQUIRES_PREREGISTRATION",
            "TEST_ONLY_POLICY_CONFIG"
          ],
          "title": "Status",
          "type": "string"
